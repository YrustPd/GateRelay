[Unit]
Description=GateRelay HTTPS reverse relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gaterelay
Group=gaterelay
ExecStart=/usr/local/bin/gaterelay -config /etc/gaterelay/config.yaml
Restart=on-failure
RestartSec=5s

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/gaterelay

[Install]
WantedBy=multi-user.target
